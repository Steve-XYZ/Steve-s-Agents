 import unittest
 from items import set_quantity
 from exporter import export_items
+from other_report import report
 
 class ExistingTests(unittest.TestCase):
     def test_quantity(self):
         self.assertEqual(set_quantity({"display_name":"x", "quantity":2}, 3)["quantity"], 3)
     def test_export(self):
         self.assertEqual(export_items([{"display_name":"x", "quantity":2}]), "display_name,quantity\nx,2\n")
+
+    def test_negative_quantity_does_not_mutate_item(self):
+        for value in (-1, "-2"):
+            with self.subTest(value=value):
+                item = {"display_name": "x", "quantity": 2}
+                with self.assertRaises(ValueError):
+                    set_quantity(item, value)
+                self.assertEqual(item, {"display_name": "x", "quantity": 2})
+
+    def test_zero_and_integer_conversion_remain_valid(self):
+        for value, expected in ((0, 0), ("0", 0), ("3", 3)):
+            with self.subTest(value=value):
+                item = {"display_name": "x", "quantity": 2}
+                self.assertIs(set_quantity(item, value), item)
+                self.assertEqual(item["quantity"], expected)
+
+    def test_invalid_quantity_does_not_mutate_item(self):
+        item = {"display_name": "x", "quantity": 2}
+        with self.assertRaises(ValueError):
+            set_quantity(item, "invalid")
+        self.assertEqual(item, {"display_name": "x", "quantity": 2})
+
+    def test_export_sorts_and_escapes_without_reordering_input(self):
+        rows = [
+            {"display_name": "Zebra", "quantity": 3, "internal": "ignored"},
+            {"display_name": 'Alpha, "quoted"\nname', "quantity": 1},
+            {"display_name": "Beta", "quantity": 2},
+        ]
+        before = [row.copy() for row in rows]
+        self.assertEqual(
+            export_items(rows),
+            'display_name,quantity\n"Alpha, ""quoted""\nname",1\nBeta,2\nZebra,3\n',
+        )
+        self.assertEqual(rows, before)
+
+    def test_report_preserves_input_order_and_csv_escaping(self):
+        rows = [
+            {"display_name": "Zebra", "quantity": 3},
+            {"display_name": "Alpha, Beta", "quantity": 1},
+        ]
+        self.assertEqual(
+            report(rows), 'display_name,quantity\nZebra,3\n"Alpha, Beta",1\n'
+        )
+
+    def test_export_empty_iterable_keeps_columns(self):
+        self.assertEqual(export_items(iter([])), "display_name,quantity\n")
+
+    def test_export_sorts_generator_and_preserves_tie_order(self):
+        rows = [
+            {"display_name": "Zebra", "quantity": 3},
+            {"display_name": "Alpha", "quantity": 2},
+            {"display_name": "Alpha", "quantity": 1},
+        ]
+        self.assertEqual(
+            export_items(iter(rows)),
+            "display_name,quantity\nAlpha,2\nAlpha,1\nZebra,3\n",
+        )
