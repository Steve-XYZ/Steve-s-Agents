 import unittest
+from pathlib import Path
 
-from inventory.cli import build_parser
+from inventory.cli import build_parser, main, resolve_options
+from inventory.settings import DEFAULTS
+
+ITEMS = [
+    {"name": "bolt", "price": 0.25, "quantity": 100},
+    {"name": "anchor", "price": 12.5, "quantity": 2},
+    {"name": "hinge", "price": 3.1, "quantity": 10},
+]
 
 
 class ParserTest(unittest.TestCase):
@@ -11,3 +24,61 @@ class ParserTest(unittest.TestCase):
     def test_export_accepts_currency(self):
         args = build_parser().parse_args(["export", "--currency", "EUR"])
         self.assertEqual(args.currency, "EUR")
+
+    def test_report_accepts_currency(self):
+        args = build_parser().parse_args(["report", "--currency", "EUR"])
+        self.assertEqual(args.currency, "EUR")
+
+
+class ResolveOptionsTest(unittest.TestCase):
+    def test_command_line_beats_settings_and_defaults(self):
+        args = build_parser().parse_args(["export", "--currency", "EUR"])
+        options = resolve_options(args, {"currency": "USD"})
+        self.assertEqual(options["currency"], "EUR")
+
+    def test_settings_beat_defaults(self):
+        args = build_parser().parse_args(["report"])
+        options = resolve_options(args, {"warehouse": "north"})
+        self.assertEqual(options["warehouse"], "north")
+
+    def test_defaults_apply_when_nothing_else_is_set(self):
+        args = build_parser().parse_args(["report"])
+        options = resolve_options(args, {})
+        self.assertEqual(options["currency"], DEFAULTS["currency"])
+
+
+class MainTest(unittest.TestCase):
+    def setUp(self):
+        workdir = tempfile.TemporaryDirectory()
+        self.addCleanup(workdir.cleanup)
+        self.addCleanup(os.chdir, os.getcwd())
+        os.chdir(workdir.name)
+        Path("inventory.toml").write_text('[inventory]\ncurrency = "USD"\n')
+        Path("items.json").write_text(json.dumps(ITEMS))
+
+    def run_main(self, *argv):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            self.assertEqual(main([*argv, "--data", "items.json"]), 0)
+        return out.getvalue()
+
+    def test_report_defaults_to_usd(self):
+        self.assertEqual(self.run_main("report").splitlines()[-1], "Total: 81.00 USD")
+
+    def test_report_currency_overrides_configured_currency(self):
+        self.assertEqual(
+            self.run_main("report", "--currency", "EUR").splitlines()[-1],
+            "Total: 74.52 EUR",
+        )
+
+    def test_export_currency_overrides_configured_currency(self):
+        self.assertEqual(
+            self.run_main("export", "--currency", "EUR"),
+            "name,quantity,price_eur\nanchor,2,11.50\nbolt,100,0.23\nhinge,10,2.85\n",
+        )
+
+    def test_export_defaults_to_configured_currency(self):
+        self.assertEqual(
+            self.run_main("export"),
+            "name,quantity,price_usd\nanchor,2,12.50\nbolt,100,0.25\nhinge,10,3.10\n",
+        )
