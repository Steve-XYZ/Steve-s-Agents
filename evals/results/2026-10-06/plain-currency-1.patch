--- a/inventory/report.py
+++ b/inventory/report.py
@@ -1,13 +1,15 @@
 from decimal import Decimal
 
+from inventory.rates import convert
+
 
 def total_value(items):
     return sum((Decimal(str(item["price"])) * item["quantity"] for item in items), Decimal("0"))
 
 
-def format_report(items, warehouse):
+def format_report(items, warehouse, currency="USD"):
     lines = [f"Warehouse: {warehouse}"]
     for item in sorted(items, key=lambda item: item["name"]):
         lines.append(f"{item['name']}: {item['quantity']}")
-    lines.append(f"Total: {total_value(items):.2f} USD")
+    lines.append(f"Total: {convert(total_value(items), currency):.2f} {currency}")
     return "\n".join(lines)
