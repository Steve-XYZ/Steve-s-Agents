+
+class ResolveOptionsTest(unittest.TestCase):
+    def resolve(self, argv, settings):
+        return resolve_options(build_parser().parse_args(argv), settings)
+
+    def test_flag_beats_settings(self):
+        options = self.resolve(["export", "--currency", "EUR"], {"currency": "USD"})
+        self.assertEqual(options["currency"], "EUR")
+
+    def test_settings_beat_defaults(self):
+        options = self.resolve(["report"], {"currency": "EUR", "data": "other.json"})
+        self.assertEqual((options["currency"], options["data"]), ("EUR", "other.json"))
+
+    def test_defaults_apply_without_flags_or_settings(self):
+        options = self.resolve(["report"], {})
+        self.assertEqual(
+            (options["warehouse"], options["currency"], options["data"]),
+            ("main", "USD", "data/items.json"),
+        )
+
+    def test_data_flag_beats_settings(self):
+        options = self.resolve(["report", "--data", "flag.json"], {"data": "other.json"})
+        self.assertEqual(options["data"], "flag.json")
+
+
+ITEMS_JSON = """[
+  {"name": "bolt", "price": 0.25, "quantity": 100},
+  {"name": "anchor", "price": 12.5, "quantity": 2},
+  {"name": "hinge", "price": 3.1, "quantity": 10}
+]"""
+
+
+class MainTest(unittest.TestCase):
+    def run_main(self, argv, settings_currency="USD"):
+        workdir = tempfile.TemporaryDirectory()
+        self.addCleanup(workdir.cleanup)
+        root = Path(workdir.name)
+        (root / "items.json").write_text(ITEMS_JSON)
+        (root / "inventory.toml").write_text(
+            f'[inventory]\ncurrency = "{settings_currency}"\ndata = "items.json"\n'
+        )
+        previous = os.getcwd()
+        self.addCleanup(os.chdir, previous)
+        os.chdir(root)
+        stdout = io.StringIO()
+        with contextlib.redirect_stdout(stdout):
+            self.assertEqual(main(argv), 0)
+        return stdout.getvalue()
+
+    def test_report_currency_flag_converts_total(self):
+        output = self.run_main(["report", "--currency", "EUR"])
+        self.assertEqual(output.splitlines()[-1], "Total: 74.52 EUR")
+
+    def test_report_without_flag_stays_usd(self):
+        output = self.run_main(["report"])
+        self.assertEqual(output.splitlines()[-1], "Total: 81.00 USD")
+
+    def test_report_without_flag_uses_currency_setting(self):
+        output = self.run_main(["report"], settings_currency="EUR")
+        self.assertEqual(output.splitlines()[-1], "Total: 74.52 EUR")
+
+    def test_export_format_is_unchanged(self):
+        self.assertEqual(
+            self.run_main(["export"]),
+            "name,quantity,price_usd\nanchor,2,12.50\nbolt,100,0.25\nhinge,10,3.10\n",
+        )
+
+    def test_export_currency_flag_beats_setting(self):
+        self.assertEqual(
+            self.run_main(["export", "--currency", "EUR"]),
