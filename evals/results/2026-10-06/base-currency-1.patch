+        lines = self.run_cli("export", settings='[inventory]\ncurrency = "USD"\n')
+        self.assertEqual(
+            lines,
+            ["name,quantity,price_usd", "anchor,2,12.50", "bolt,100,0.25", "hinge,10,3.10"],
+        )
+
+    def test_configured_data_path_is_the_default_source(self):
+        (self.directory / "other.json").write_text(json.dumps([ITEMS[1]]))
