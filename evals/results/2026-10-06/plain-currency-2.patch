--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,22 @@
+import unittest
+
+from inventory.export import export_csv
+
+ITEMS = [
+    {"name": "bolt", "price": 0.25, "quantity": 100},
+    {"name": "anchor", "price": 12.5, "quantity": 2},
+]
+
+
+class ExportTest(unittest.TestCase):
+    def test_usd_rows_sorted_by_name(self):
+        self.assertEqual(
+            export_csv(ITEMS, "USD"),
+            "name,quantity,price_usd\nanchor,2,12.50\nbolt,100,0.25\n",
+        )
+
+    def test_eur_prices_converted_per_item(self):
+        self.assertEqual(
+            export_csv(ITEMS, "EUR"),
+            "name,quantity,price_eur\nanchor,2,11.50\nbolt,100,0.23\n",
+        )
