@@ -9,6 +10,30 @@ class DirectoryTest(unittest.TestCase):
     def test_wire_format(self):
         self.assertEqual(export_directory(Source()), "key,label,tags\r\na,ALPHA,\r\nb,BETA,\r\n")
 
+    def test_default_wire_format(self):
+        self.assertEqual(export_directory(), "key,label,tags\r\na,ALPHA,\r\nb,BETA,\r\n")
+
+    def test_default_uses_canonical_source(self):
+        with patch.object(Source, "records", return_value=[{"key": "c", "label": "Canonical"}]):
+            self.assertEqual(export_directory(), "key,label,tags\r\nc,CANONICAL,\r\n")
+
+    def test_source_order_and_csv_escaping(self):
+        rows = [{"key": "b", "label": "Beta, B"}, {"key": "a", "label": 'Alpha "A"'}]
+        with patch.object(Source, "records", return_value=rows):
+            text = export_directory(Source())
+        self.assertEqual(text, 'key,label,tags\r\nb,"BETA, B",\r\na,"ALPHA ""A""",\r\n')
+        self.assertEqual(import_directory(text), [
+            {"key": "b", "label": "BETA, B", "tags": ""},
+            {"key": "a", "label": 'ALPHA "A"', "tags": ""},
+        ])
+
+    def test_tags_are_stable_across_rows_and_exports(self):
+        self.assertEqual(export_directory(tags=("one", "two")),
+                         "key,label,tags\r\na,ALPHA,one;two\r\nb,BETA,one;two\r\n")
+        self.assertEqual(export_directory(tags=("three",)),
+                         "key,label,tags\r\na,ALPHA,three\r\nb,BETA,three\r\n")
+        self.assertEqual(export_directory(), "key,label,tags\r\na,ALPHA,\r\nb,BETA,\r\n")
+
     def test_consumer(self):
         self.assertEqual(import_directory(export_directory(Source()))[0], {"key": "a", "label": "ALPHA", "tags": ""})
 
