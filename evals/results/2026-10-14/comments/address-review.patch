+import unittest
+from address import join_address
+
+
+class AddressTest(unittest.TestCase):
+    def test_address_parts(self):
+        self.assertEqual(join_address(["12 Maple", "", "Paris"]), "12 Maple, Paris")
+
+    def test_empty_parts(self):
+        self.assertEqual(join_address([]), "")
